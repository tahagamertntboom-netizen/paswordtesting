def clear():
    for widget in root.winfo_children():
        widget.destroy()

def fullscreen():
    root.attributes("-fullscreen", not root.attributes("-fullscreen"))

def key(event):
    if event.keysym == "Escape":
        root.attributes("-fullscreen", False)

root.bind("<F11>", lambda e: fullscreen())
root.bind("<Escape>", key)

def button(parent, text, command, color=CARD2, fg=WHITE):
    return tk.Button(
        parent,
        text=text,
        command=command,
        bg=color,
        fg=fg,
        activebackground=GREEN,
        activeforeground=BG,
        font=("Segoe UI", 12, "bold"),
        relief="flat",
        cursor="hand2",
        padx=20,
        pady=12
    )

def label(parent, text, size=12, color=WHITE, bold=False):
    return tk.Label(
        parent,
        text=text,
        bg=parent["bg"],
        fg=color,
        font=("Segoe UI", size, "bold" if bold else "normal")
    )

def header():
    top = tk.Frame(root, bg=BG)
    top.pack(fill="x", padx=35, pady=20)

    label(top, "PASSWORD MASTER", 23, GREEN, True).pack(side="left")

    button(top, "FULLSCREEN  F11", fullscreen).pack(side="right")

