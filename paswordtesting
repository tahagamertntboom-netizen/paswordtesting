def choose_mode(selected):
    global level
    level = selected

    clear()
    header()

    label(root, level + " MODE", 28, GREEN, True).pack(pady=(70, 10))
    label(root, "Choose how to create your password", 13, GRAY).pack()

    box = tk.Frame(root, bg=CARD, padx=35, pady=35)
    box.pack(pady=35)

    button(
        box,
        "WRITE MY PASSWORD",
        lambda: manual_page(),
        BLUE
    ).pack(fill="x", pady=12)

    button(
        box,
        "AUTO GENERATE",
        lambda: automatic_page(),
        GREEN,
        BG
    ).pack(fill="x", pady=12)

    button(root, "BACK", home).pack()

def password_score(password):
    score = 0

    if len(password) >= 8:
        score += 20
    if len(password) >= 12:
        score += 20
    if len(password) >= 16:
        score += 10
    if any(c.islower() for c in password):
        score += 10
    if any(c.isupper() for c in password):
        score += 10
    if any(c.isdigit() for c in password):
        score += 15
    if any(not c.isalnum() for c in password):
        score += 15

    return min(score, 100)

def rating(score):
    if score < 30:
        return "VERY WEAK", RED
    elif score < 50:
        return "WEAK", "#ffb84d"
    elif score < 70:
        return "GOOD", "#e6d85c"
    elif score < 90:
        return "STRONG", BLUE
    return "EXCELLENT", GREEN

def analyze(password):
    score = password_score(password)
    name, color = rating(score)

    clear()
    header()

    label(root, "PASSWORD ANALYSIS", 24, WHITE, True).pack(pady=35)

    box = tk.Frame(root, bg=CARD, padx=35, pady=30)
    box.pack(fill="x", padx=80)

    label(box, "SECURITY SCORE", 12, GRAY, True).pack()

    label(
        box,
        str(score) + " / 100",
        32,
        color,
        True
    ).pack(pady=10)

    bar_bg = tk.Frame(box, bg=CARD2, height=18)
    bar_bg.pack(fill="x", pady=15)

    bar = tk.Frame(bar_bg, bg=GREEN, height=18)
    bar.place(relx=0, rely=0, relheight=1, relwidth=score / 100)

    label(box, name, 18, color, True).pack(pady=10)

    tips = []

    if len(password) < 12:
        tips.append("Use at least 12 characters.")
    if not any(c.isupper() for c in password):
        tips.append("Add uppercase letters.")
    if not any(c.islower() for c in password):
        tips.append("Add lowercase letters.")
    if not any(c.isdigit() for c in password):
        tips.append("Add numbers.")
    if not any(not c.isalnum() for c in password):
        tips.append("Add special characters.")

    label(box, "SECURITY TIPS", 12, GREEN, True).pack(pady=(15, 5))

    if tips:
        for tip in tips:
            label(box, "• " + tip, 10, GRAY).pack(anchor="w")
    else:
        label(box, "Great! Your password meets all basic checks.", 10, GREEN).pack()

    button(root, "BACK TO HOME", home).pack(pady=30)

def manual_page():
    clear()
    header()

    label(root, "ENTER YOUR PASSWORD", 25, WHITE, True).pack(pady=40)

    box = tk.Frame(root, bg=CARD, padx=35, pady=35)
    box.pack(padx=70, fill="x")

    label(box, "YOUR PASSWORD", 12, GRAY, True).pack()

    entry = tk.Entry(
        box,
        font=("Consolas", 18),
        bg=CARD2,
        fg=WHITE,
        insertbackground=GREEN,
        relief="flat",
        justify="center",
        show="*"
    )
    entry.pack(fill="x", pady=20, ipady=12)

    show = tk.BooleanVar(value=False)

    def toggle():
        entry.config(show="" if show.get() else "*")

    tk.Checkbutton(
        box,
        text="Show password",
        variable=show,
        command=toggle,
        bg=CARD,
        fg=GRAY,
        selectcolor=CARD2,
        activebackground=CARD
    ).pack()

    def check():
        p = entry.get()
        if not p:
            label(root, "Please enter a password.", 11, RED).pack()
            return
        analyze(p)

    button(box, "ANALYZE PASSWORD", check, GREEN, BG).pack(pady=20)
    button(root, "BACK", lambda: choose_mode(level)).pack(pady=15)

def generate_password():
    settings = {
        "BAD": (6, string.ascii_lowercase + string.digits),
        "GOOD": (12, string.ascii_letters + string.digits),
        "EXCELLENT": (18, string.ascii_letters + string.digits + "!@#$%^&*"),
        "GOD": (28, string.ascii_letters + string.digits + "!@#$%^&*_-+=?")
    }

    length, chars = settings[level]

    while True:
        password = "".join(random.SystemRandom().choice(chars) for _ in range(length))

        if (any(c.islower() for c in password)
            and any(c.isupper() for c in password)
            and any(c.isdigit() for c in password)
            and any(not c.isalnum() for c in password)):
            return password

