        font=("Consolas", 18, "bold"),
        justify="center",
        relief="flat"
    )
    display.pack(fill="x", pady=20, ipady=15)

    score = password_score(password)
    name, color = rating(score)

    label(box, level + " SECURITY", 14, GREEN, True).pack(pady=8)
    label(box, name + "  |  " + str(score) + "/100", 15, color, True).pack()

    def copy_password():
